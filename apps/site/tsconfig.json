{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitepress/client"],
    // Type-checks against the player's sources, so no build is needed first.
    "paths": { "folioscope": ["../../packages/folioscope/src/index.ts"] }
  },
  "include": [".vitepress/**/*.ts", "scripts/**/*.ts"]
}
