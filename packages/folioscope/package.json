{
  "name": "folioscope",
  "version": "0.0.2",
  "description": "Flip through your prototypes: a web component that plays interactive .fig, .sketch, .xd and .penpot prototypes",
  "keywords": [
    "custom-element",
    "design",
    "mockup",
    "player",
    "portfolio",
    "prototype",
    "web-component"
  ],
  "homepage": "https://folioscope.baxyz.dev",
  "bugs": {
    "url": "https://github.com/baxyz/folioscope/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "baxyz <berenger@arnaud.work>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baxyz/folioscope.git",
    "directory": "packages/folioscope"
  },
  "files": [
    "dist",
    "wasm"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.mjs"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./vite": "./dist/vite/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "test:e2e": "node e2e/navigation.e2e.ts",
    "test:budget": "node e2e/budget.e2e.ts",
    "build:wasm": "node scripts/build-wasm.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "thumbhash": "0.1.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "thumbhash": "0.1.1"
  }
}
